#!/usr/bin/env bash
# fb-isolated — run a command with sibling worktrees hidden.
#
# Must be a real executable, not a shell function: systemd-run execs its argument directly and
# reports "Failed to find executable fb_isolated" for a function. Two runs died at 0s that way.
#
# THIS IS THE ONE IMPLEMENTATION. fb-isolate.sh's `fb_isolated` function delegates here.
# There were two copies of the bwrap invocation -- this executable on the dispatch path and a
# shell function on the critique path -- and the admin-directory guard below was added to the
# FUNCTION only. I then verified the fix by calling the function, which is the copy I had
# fixed, and reported it as holding. It was not holding anywhere that mattered: every wave
# dispatched afterwards went through this file and destroyed worktrees exactly as before,
# taking the healthy count from 78 to 11.
#
#   fb-isolated <worktree> <cmd...>
set -uo pipefail
wt="${1:?worktree}"; shift
root="$HOME/.local/share/farmerbob/worktrees"
admin="${FB_GIT_WORKTREES:-/home/gabe/Documents/farmerbob/.git/worktrees}"

if [ "${FB_NO_ISOLATE:-0}" = 1 ] || ! command -v bwrap >/dev/null 2>&1; then
  exec "$@"
fi

# The tmpfs hides every sibling worktree, which is the point -- but it also hides them from
# GIT, whose admin directories live in the shared .git and stay writable under --dev-bind.
# Inside this namespace `git worktree prune` sees ~200 worktrees whose "gitdir file points to
# non-existent location" and deletes every one of their admin directories. The files survive;
# the repository forgets they are worktrees, so `git diff` answers "fatal: not a git
# repository" forever after and the scorer reads that as the arm having written nothing.
#
# Fix: the admin directory is read-only in here, with THIS run's own entry bound back
# writable so its own git still works.  (bead farmerbob-13p)
guard=()
if [ -d "$admin" ]; then
  guard+=(--ro-bind "$admin" "$admin")
  own="$admin/$(basename "$wt")"
  [ -d "$own" ] && guard+=(--bind "$own" "$own")
fi

# THE ORCHESTRATOR'S OWN WORKING TREE IS READ-ONLY IN HERE.
#
# `--dev-bind / /` binds the whole filesystem READ-WRITE. The tmpfs above hides sibling
# worktrees from each other, which is what this file was written for, but nothing stopped an
# arm writing to /home/gabe/Documents/farmerbob itself -- its specs, its shell scripts, its
# sources.toml, or its source.
#
# Not hypothetical. decl-cmd/glm-53-flash resumed its speccheck session, whose working
# directory was the main repo rather than the worktree, and wrote crates/fb/src/decl_cmd.rs
# and a `mod decl_cmd;` line STRAIGHT INTO THE ORCHESTRATOR'S TREE. It scored NO-OP -- the
# worktree was untouched -- while its log read "All three gates pass in
# /home/gabe/Documents/farmerbob (the repo this task targets)".  (bead farmerbob-p3r)
#
# `.git` stays WRITABLE. A worktree shares the repository's object store, so an arm that
# commits on its own branch writes objects into $repo/.git, and the scorer measures committed
# work deliberately (farmerbob-qv6u). Read-only there would break committing, which is worse
# than what it fixes. The guard below then re-applies the admin-directory protection on top.
repo="${FB_REPO:-${admin%/.git/worktrees}}"
shield=()
if [ -d "$repo" ]; then
  shield+=(--ro-bind "$repo" "$repo")
  [ -d "$repo/.git" ] && shield+=(--bind "$repo/.git" "$repo/.git")
fi

exec bwrap --dev-bind / / \
           "${shield[@]}" \
           --tmpfs "$root" \
           --bind "$wt" "$wt" \
           "${guard[@]}" \
           -- "$@"
